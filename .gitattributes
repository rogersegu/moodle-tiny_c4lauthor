# Files excluded from git archive (the Moodle Plugin Directory packaging
# pipeline uses `git archive` to build the install ZIP). Anything marked
# with export-ignore stays in the repo for developers but is stripped
# from the distribution that end users receive.

.github/                                    export-ignore
.gitattributes                              export-ignore
.gitignore                                  export-ignore
.claude/                                    export-ignore

# The stylesheet build. Moodle never compiles a plugin's scss itself: it serves
# the committed styles.css and editor_styles.css, so neither the sources nor the
# sass tooling is needed at runtime. Both stay in the repo for developers.
scss/                                       export-ignore
package.json                                export-ignore

# The build of dist/, which the standalone fallback page reads. dist/ itself ships.
tools/                                      export-ignore

*.css.map                                   export-ignore
*.min.js.map                                export-ignore
.DS_Store                                   export-ignore
*/.DS_Store                                 export-ignore
