{{!
    @template tiny_c4lauthor/components/carousel

    The markup C4L Author inserts for the Carousel component.

    Each slide holds an image, added in the editor. Without JavaScript the slides
    show one below the other; the page script (tiny_c4lauthor/runtime) turns them
    into a carousel.

    Context variables required for this template:
    * variantclasses - classes of the active variants

    Example context (json):
    {"placeholder":"<span data-id=\"R1-1\">Text</span>","variantclasses":"","variantshtml":"","uniqid":"R2-2"}
}}
<p class="c4l-spacer">&nbsp;</p><div class="c4lv-carousel {{variantclasses}}" contenteditable="false"><div class="c4l-slide"></div><div class="c4l-slide"></div><div class="c4l-slide"></div></div><p class="c4l-spacer">&nbsp;</p>
