{{!
    @template tiny_c4lauthor/components/styledlist

    The markup C4L Author inserts for the Styled list component.

    Context variables required for this template:
    * placeholder - HTML of the placeholder span (tiny_c4lauthor/placeholder_span)
    * variantclasses - classes of the active variants

    Example context (json):
    {"placeholder":"<span data-id=\"R1-1\">Text</span>","variantclasses":"","variantshtml":"","uniqid":"R2-2"}
}}
<p class="c4l-spacer">&nbsp;</p><ul class="c4lv-styledlist c4l-checkmarks-variant {{variantclasses}}"><li>{{{placeholder}}}</li><li>Lorem ipsum dolor sit amet consectetur.</li><li>Pellentesque eget sodales mi imperdiet.</li></ul><p class="c4l-spacer">&nbsp;</p>
