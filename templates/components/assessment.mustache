{{!
    @template tiny_c4lauthor/components/assessment

    The markup C4L Author inserts for the Assessment component.

    Context variables required for this template:
    * placeholder - HTML of the placeholder span (tiny_c4lauthor/placeholder_span)
    * variantclasses - classes of the active variants

    Example context (json):
    {"placeholder":"<span data-id=\"R1-1\">Text</span>","variantclasses":"","variantshtml":"","uniqid":"R2-2"}
}}
<p class="c4l-spacer">&nbsp;</p><div class="c4lv-assessment {{variantclasses}}"><section id="task-compound-layout">
<div class="teacher-assessment">
<div class="teacher-assessment-frame"></div>
<div class="teacher-assessment-text">
<p>{{{placeholder}}}</p>
</div>
</div>
</section></div><p class="c4l-spacer">&nbsp;</p>
