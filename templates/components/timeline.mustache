{{!
    @template tiny_c4lauthor/components/timeline

    The markup C4L Author inserts for the Timeline component.

    Context variables required for this template:
    * placeholder - HTML of the placeholder span (tiny_c4lauthor/placeholder_span)
    * variantclasses - classes of the active variants

    Example context (json):
    {"placeholder":"<span data-id=\"R1-1\">Text</span>","variantclasses":"","variantshtml":"","uniqid":"R2-2"}
}}
<div class="c4lv-timeline {{variantclasses}}"><div class="c4l-timeline-events"><div class="c4l-timeline-event"><div class="c4l-timeline-pill"><div class="c4l-timeline-marker" contenteditable="false"></div><span class="c4l-timeline-year">2008</span></div><p class="c4l-timeline-text">{{{placeholder}}}</p></div><div class="c4l-timeline-event"><div class="c4l-timeline-pill"><div class="c4l-timeline-marker" contenteditable="false"></div><span class="c4l-timeline-year">2012</span></div><p class="c4l-timeline-text">Lorem ipsum dolor sit amet consectetur.</p></div><div class="c4l-timeline-event"><div class="c4l-timeline-pill"><div class="c4l-timeline-marker" contenteditable="false"></div><span class="c4l-timeline-year">2016</span></div><p class="c4l-timeline-text">Pellentesque eget sodales mi imperdiet.</p></div></div></div>
