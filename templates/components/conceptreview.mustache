{{!
    @template tiny_c4lauthor/components/conceptreview

    The markup C4L Author inserts for the Concept review component.

    Context variables required for this template:
    * placeholder - HTML of the placeholder span (tiny_c4lauthor/placeholder_span)
    * variantclasses - classes of the active variants

    Example context (json):
    {"placeholder":"<span data-id=\"R1-1\">Text</span>","variantclasses":"","variantshtml":"","uniqid":"R2-2"}
}}
<p class="c4l-spacer">&nbsp;</p><div class="c4lv-conceptreview {{variantclasses}}" role="note" aria-label="{{#str}}conceptreview, tiny_c4lauthor{{/str}}"><h6 class="c4l-concept-review-title">{{#str}}conceptreview, tiny_c4lauthor{{/str}}</h6>{{{placeholder}}}</div><p class="c4l-spacer">&nbsp;</p>
