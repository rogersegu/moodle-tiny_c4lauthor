{{!
    @template tiny_c4lauthor/components/styledtable

    The markup C4L Author inserts for the Styled table component.

    Context variables required for this template:
    * variantclasses - classes of the active variants

    Example context (json):
    {"placeholder":"<span data-id=\"R1-1\">Text</span>","variantclasses":"","variantshtml":"","uniqid":"R2-2"}
}}
<p class="c4l-spacer">&nbsp;</p><div class="c4l-table-container c4l-solid-variant w-100 mx-auto {{variantclasses}}"><table class="c4l-styled-table table table-responsive"><thead><tr><th scope="col"></th><th scope="col">{{#str}}table_col, tiny_c4lauthor{{/str}} 1</th><th scope="col">{{#str}}table_col, tiny_c4lauthor{{/str}} 2</th><th scope="col">{{#str}}table_col, tiny_c4lauthor{{/str}} 3</th><th scope="col">{{#str}}table_col, tiny_c4lauthor{{/str}} 4</th></tr></thead><tbody><tr><th scope="row">{{#str}}table_row, tiny_c4lauthor{{/str}} 1</th><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 1.1</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 1.2</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 1.3</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 1.4</td></tr><tr><th scope="row">{{#str}}table_row, tiny_c4lauthor{{/str}} 2</th><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 2.1</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 2.2</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 2.3</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 2.4</td></tr><tr><th scope="row">{{#str}}table_row, tiny_c4lauthor{{/str}} 3</th><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 3.1</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 3.2</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 3.3</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 3.4</td></tr><tr><th scope="row">{{#str}}table_row, tiny_c4lauthor{{/str}} 4</th><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 4.1</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 4.2</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 4.3</td><td>{{#str}}cell_content, tiny_c4lauthor{{/str}} 4.4</td></tr></tbody></table></div><p><br></p><p class="c4l-spacer">&nbsp;</p>
