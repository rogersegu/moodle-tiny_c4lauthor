{{!
    @template tiny_c4lauthor/components/linkblock

    The markup C4L Author inserts for the Link block component.

    The link goes to href; the URL shown is only text. Precision mode sets both.

    Context variables required for this template:
    * placeholder - HTML of the placeholder span (tiny_c4lauthor/placeholder_span)

    Example context (json):
    {"placeholder":"<span data-id=\"R1-1\">Text</span>","variantclasses":"","variantshtml":"","uniqid":"R2-2"}
}}
<p class="c4l-spacer">&nbsp;</p><a href="https://example.com" target="_blank" class="c4l-linkblock"><span class="link-stripe">&nbsp;</span><span class="link-content"><span class="link-name">{{{placeholder}}}</span><span class="link-url">https://example.com</span></span></a><p class="c4l-spacer">&nbsp;</p>
