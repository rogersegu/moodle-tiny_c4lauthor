{{!
    @template tiny_c4lauthor/components/dodontcards

    The markup C4L Author inserts for the Do/don't cards component.

    Context variables required for this template:
    * placeholder - HTML of the placeholder span (tiny_c4lauthor/placeholder_span)
    * variantclasses - classes of the active variants

    Example context (json):
    {"placeholder":"<span data-id=\"R1-1\">Text</span>","variantclasses":"","variantshtml":"","uniqid":"R2-2"}
}}
<p class="c4l-spacer">&nbsp;</p><div class="c4lv-dodontcards {{variantclasses}}"
            role="note" aria-label="{{#str}}dodontcards, tiny_c4lauthor{{/str}}">
            <div class="c4l-dodontcards-do" role="note" aria-label="{{#str}}do-card, tiny_c4lauthor{{/str}}">{{{placeholder}}}</div>
            <div class="c4l-dodontcards-dont" role="note" aria-label="{{#str}}dont-card, tiny_c4lauthor{{/str}}">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit.
            Phasellus a posuere nibh, eu mollis lacus.
            Praesent dictum in velit sed dapibus. Orci varius natoque penatibus et magnis dis parturient montes,
            nascetur ridiculus mus.</div></div><p class="c4l-spacer">&nbsp;</p>
